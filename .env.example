# =============================================================================
# theseus-kit E2E 测试 — 环境变量模板
#
# 用法：
#   cp .env.example .env
#   # 编辑 .env 填入真实值
#   THESEUS_E2E=1 uv run pytest tests/test_e2e_robot.py -v -m e2e
#
# .env 已在 .gitignore 中，不会被提交。
# =============================================================================

# -- E2E 测试开关 --------------------------------------------------------------
# 设为 1 才会连接真实机器人；不设或设为 0 则跳过 E2E 测试。
THESEUS_E2E=1


# =============================================================================
# 第 1 部分：机器人路由目标（ROBOT TARGET）
#
# 这些值决定了 MCP 服务器连接哪个机器人、在哪个集群、走什么路由。
# 所有 X-TF-* 头部值必须匹配正则 ^[a-z0-9-]+$
# =============================================================================

# rid —— 机器人在 TFRobot 系统中的唯一路由标识。
# 来源：TFRobot 管理后台 → 机器人详情页 →「Robot ID」字段。
# 注意：rid ≠ public_id（见下文 ROBOT_PUBLIC_ID），两者是不同的标识符。
THESEUS_ROBOT__ROBOT_ID=

# 租户 K8s Namespace —— 机器人所在命名空间。
# 来源：TFRobot 管理后台 → 机器人详情页 →「命名空间」字段，
#       或通过 kubectl get ns | grep <机器人名> 查看。
THESEUS_ROBOT__NAMESPACE=

# 机器人类型 —— 决定后端 TFRobotServer 分发哪个配置解释器。
# 可选值：tfrobot | openclaw | ...
# 来源：TFRobot 管理后台 → 机器人详情页 →「类型」字段。
THESEUS_ROBOT__ROBOT_TYPE=tfrobot

# 机器人 HTTP 入口 —— 集群 Istio 网关地址。
# Staging 环境格式：https://api.<staging-cluster-domain>
# 来源：运维提供的集群域名，或 kubectl get vs -n <namespace> 查看 VirtualService。
THESEUS_ROBOT__API_BASE_URL=

# TFRSManager 公共入口 —— 用于 POST /api/v1/oauth/token 换发令牌。
# 注意：这是 Manager 的地址，不是机器人的地址。
# 来源：运维提供的 Manager 对外域名，或查看 Manager Service/Ingress。
THESEUS_ROBOT__MANAGER_BASE_URL=


# =============================================================================
# 第 2 部分：凭证（CREDENTIAL）
#
# 当前支持两种凭证路径：
#   (A) user_pat —— 用户个人令牌（推荐，theseus-kit 是人管配置的工具）
#   (B) oauth    —— OAuth 2.0（MCP Client 驱动授权）
#
# 下面以 (A) user_pat 为例。
# =============================================================================

# 凭证类型，固定值。
THESEUS_CREDENTIAL__KIND=user_pat

# 用户的个人访问令牌（PAT）。
#
# 来源：
#   管理后台 / UserPortal → 个人设置 →「访问令牌」/「Personal Access Token」。
#   格式：tfp_ 开头。
#
# 安全注意：
#   - 该值会被 pydantic SecretStr 包装，默认 repr/logs 不会泄露。
#   - .env 文件不要提交到 Git（已在 .gitignore 中）。
THESEUS_CREDENTIAL__PAT=

# 目标机器人的 public_id —— 格式为 {orgSlug}:{employeeNo}。
#
# 来源：
#   TFRobot 管理后台 → 机器人详情页 →「Account ID」或「Public ID」。
#   格式：orgSlug 是小写字母+数字+连字符，employeeNo 是字母+数字。
#   示例：my-org:EMP001
#   正则约束：^[a-z0-9-]+:[a-zA-Z0-9]+$
#
# 注意：PAT 代表用户身份，ROBOT_PUBLIC_ID 告诉 Manager 要把令牌换发到哪个机器人的 scope。
THESEUS_CREDENTIAL__ROBOT_PUBLIC_ID=

# 可选：显式缩窄 Manager 换发的短 Token scope。
# 不设置时默认申请 theseus-kit 的三个配置 scope，再与 PAT 和目标 Robot 权限求交。
# THESEUS_CREDENTIAL__SCOPES=config:read config:write config:publish


# =============================================================================
# 第 3 部分：可选配置
# =============================================================================

# -- 扩展 E2E 测试覆盖 ---------------------------------------------------------

# 额外验证一个 llm-docs 端点（如 /llms.txt 之外的具体文档路径）。
# 来源：TFRobot 管理后台 → 机器人配置 → llm-docs 目录列表。
# THESEUS_E2E_FACTORY_DOC=

# 额外验证一个通用 read API 端点（如 /v1/factory/...）。
# 测试会断言 HTTP 200。
# THESEUS_E2E_READ_API=

# -- TLS / 证书 -----------------------------------------------------------------
# 如果 staging 环境使用自签证书或内部 CA，取消下面的注释。

# 跳过 HTTPS 证书校验（仅开发/调试，生产不要用）：
# THESEUS_ROBOT__VERIFY=false

# 或指定自定义 CA bundle 路径：
# THESEUS_ROBOT__CA_BUNDLE=/path/to/your/ca-bundle.crt

# -- 超时 -----------------------------------------------------------------------
# 默认 30 秒，网络较慢时可调大：
# THESEUS_ROBOT__TIMEOUT_S=60.0
